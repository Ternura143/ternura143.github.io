---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { GITHUB_USERNAME, SOCIALS } from "@/consts"
import { getCollection } from "astro:content"

const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.year - a.data.year,
)

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0),
)

const news = [
  {
    date: "2026-06",
    text: 'New paper on arXiv: "Unified Context Evolution for LLM Agents".',
  },
]
---

<Layout>
  <MetaPage slot="head" />

  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="page-kicker" data-time-greeting>Hello</p>
      <h1 id="home-title"><em data-decode="Zixuan Zhu">Zixuan Zhu</em></h1>
      <p class="home-role">MSc student @ NTU.</p>
      <div class="home-about">
        <p>
          I am Zixuan Zhu, an MSc student at the School of Physical and Mathematical
          Sciences, Nanyang Technological University (NTU), graduating in 2026. I
          received my dual bachelor's degree from Beijing University of Posts and
          Telecommunications (BUPT) and Queen Mary University of London (QMUL).
        </p>
        <p class="home-seeking">
          I am looking for PhD, RA, or research-internship opportunities, and I am open
          to research collaborations. Please feel free to reach out, even just for a
          coffee chat.
        </p>
        <p>My research currently centers on the following topics:</p>
        <ul class="interest-list">
          <li>
            <strong>Self-evolving agents</strong>: how agents can continually and stably
            self-improve from their own experience (<a
              href="https://arxiv.org/abs/2606.02304"
              target="_blank"
              rel="noopener noreferrer">UCE</a
            >).
          </li>
          <li>
            <strong>Scalable evaluation</strong>: how to scale agent evaluation
            efficiently and in parallel (<a
              href="https://github.com/harbor-framework/harbor"
              target="_blank"
              rel="noopener noreferrer">Harbor</a
            >), and keep it robust and trustworthy.
          </li>
          <li>
            <strong>Economics of AI</strong>: how to reduce the token cost of agentic
            reasoning and get more capability from every token, until capable agents
            become viable on small, widely accessible models.
          </li>
        </ul>
        <p>
          I am fortunate to collaborate with <a
            href="https://people.csail.mit.edu/ludwigs/"
            target="_blank"
            rel="noopener noreferrer">Prof. Ludwig Schmidt</a
          >, <a
            href="https://scholar.google.com/citations?user=dLwY-1YAAAAJ"
            target="_blank"
            rel="noopener noreferrer">Lin Shi</a
          >, and <a
            href="https://linhaowei1.github.io/"
            target="_blank"
            rel="noopener noreferrer">Haowei Lin</a
          > on agent benchmarking, and with <a
            href="https://dl-m9.github.io/"
            target="_blank"
            rel="noopener noreferrer">Senkang Hu</a
          > on self-evolving agents.
        </p>
      </div>
    </div>
    <div class="home-hero-aside">
      <figure class="profile-photo">
        <img src="/static/profile.png" alt="Zixuan Zhu">
      </figure>
      <div class="social-links" aria-label="Social links">
        {SOCIALS.map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith("http") ? "_blank" : undefined}
            rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {social.label}
            {social.href.startsWith("http") && <span class="arrow"> ↗</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section" aria-labelledby="recent-news">
    <div class="section-label" id="recent-news">
      <span>Recent News</span>
    </div>
    <div class="news-list">
      {news.map((item) => (
        <div class="news-item">
          <time datetime={item.date}>{item.date}</time>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section
    class="site-section"
    id="publications"
    aria-labelledby="publications-label"
  >
    <div class="section-label" id="publications-label">
      <span>Publications</span>
    </div>
    <div class="ink-list">
      {publications.map((publication) => (
        <article class="ink-entry" id={publication.id}>
          <h2>{publication.data.title}</h2>
          <div class="entry-meta">
            <span class="tag">{publication.data.venue}</span>
            <span>{publication.data.year}</span>
            {publication.data.status && <span>{publication.data.status}</span>}
            <span>
              {publication.data.authors.map((author, index) => (
                <Fragment>
                  {index > 0 && ", "}
                  {author === "Zixuan Zhu" ? <strong>{author}</strong> : author}
                </Fragment>
              ))}
            </span>
          </div>
          {publication.data.abstract && (
            <p class="entry-summary">{publication.data.abstract}</p>
          )}
          <div class="entry-links">
            {publication.data.arxiv && (
              <a href={publication.data.arxiv} target="_blank" rel="noopener noreferrer">
                Paper <span class="arrow">↗</span>
              </a>
            )}
            {publication.data.pdf && (
              <a href={publication.data.pdf} target="_blank" rel="noopener noreferrer">
                PDF <span class="arrow">↗</span>
              </a>
            )}
            {publication.data.code &&
              (publication.data.code.startsWith("http") ? (
                <a href={publication.data.code} target="_blank" rel="noopener noreferrer">
                  Code <span class="arrow">↗</span>
                </a>
              ) : (
                <span>Code ({publication.data.code})</span>
              ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" id="projects" aria-labelledby="projects-label">
    <div class="section-label" id="projects-label">
      <span>Projects</span>
    </div>
    <div class="ink-list">
      {projects.map((project) => (
        <article class="ink-entry" id={project.id}>
          <h2>{project.data.name}</h2>
          <div class="entry-meta">
            {project.data.role && <span class="tag">{project.data.role}</span>}
            {project.data.status && <span>{project.data.status}</span>}
            {project.data.tags?.map((tag) => <span>{tag}</span>)}
          </div>
          <p class="entry-summary">{project.data.description}</p>
          <div class="entry-links">
            {project.data.website && (
              <a href={project.data.website} target="_blank" rel="noopener noreferrer">
                Website <span class="arrow">↗</span>
              </a>
            )}
            {project.data.link && (
              <a href={project.data.link} target="_blank" rel="noopener noreferrer">
                Code <span class="arrow">↗</span>
              </a>
            )}
            {!project.data.website && !project.data.link && (
              <span class="project-status">Repository coming soon</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" aria-labelledby="github-heatmap">
    <div class="section-label" id="github-heatmap">
      <span>GitHub · Last Year</span>
    </div>
    <div class="heatmap-shell">
      <div
        class="heatmap"
        data-github-heatmap
        data-github-user={GITHUB_USERNAME}
        aria-label={`GitHub contribution heatmap for ${GITHUB_USERNAME}`}
      >
        <p class="heatmap-message">Loading GitHub contribution data...</p>
      </div>
    </div>
    <div class="heatmap-legend" aria-hidden="true">
      less <i></i><i></i><i></i><i></i>
      more
    </div>
  </section>

</Layout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-l);
    align-items: start;
    padding-block: var(--space-l) var(--space-xl);
  }

  .home-hero h1 {
    margin-block: 0 var(--space-s);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 3vw, 3.1rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.08;
  }

  .home-hero h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .home-role {
    margin-block: 0 var(--space-m);
    font-family: var(--font-mono);
    color: var(--muted-foreground);
  }

  .home-about {
    max-inline-size: 58ch;
    margin-block: 0 var(--space-m);
    color: var(--muted-foreground);
  }

  .home-about p {
    margin-block: 0 var(--space-s);
  }

  .home-about a {
    color: var(--accent);
    text-decoration: none;
  }

  .interest-list {
    margin-block: 0 var(--space-s);
    padding-inline-start: 1.1rem;
  }

  .interest-list li {
    margin-block-end: var(--space-2xs);
  }

  .interest-list strong {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  .home-seeking {
    color: var(--seek);
    font-weight: var(--font-weight-medium);
  }

  .home-hero-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    align-items: flex-start;
  }

  .home-hero-aside .social-links {
    flex-direction: column;
    gap: 0.4rem;
  }

  .profile-photo {
    display: grid;
    gap: var(--space-2xs);
    justify-items: center;
    inline-size: 8.25rem;
    margin: 0;
    transform: rotate(0deg);
    transition: transform 0.25s ease;
  }

  .profile-photo:hover {
    transform: rotate(2deg);
  }

  .profile-photo img {
    inline-size: 8.25rem;
    block-size: 9.875rem;
    object-fit: cover;
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-sm);
    background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 8px,
        color-mix(in srgb, var(--accent) 8%, transparent) 8px,
        color-mix(in srgb, var(--accent) 8%, transparent) 16px
      ),
      var(--paper-soft);
  }

  .profile-photo figcaption {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (width < 40rem) {
    .home-hero {
      grid-template-columns: 1fr;
    }

    .profile-photo {
      transform: none;
    }
  }
</style>
