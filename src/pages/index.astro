---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { GITHUB_USERNAME, SOCIALS } from "@/consts"
import { getCollection } from "astro:content"

const MONTHS = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
]
const fmtMonth = (ym: string) => {
  const [year, month] = ym.split("-")
  return `${MONTHS[Number(month) - 1]} ${year}`
}

const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.year - a.data.year,
)

const projects = (await getCollection("projects")).sort((a, b) => {
  const orderA = a.data.order ?? Infinity
  const orderB = b.data.order ?? Infinity
  if (orderA !== orderB) return orderA - orderB
  return (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0)
})

const news = [
  {
    date: "2026-09",
    prefix: "New paper on arXiv: ",
    title:
      "Harbor Adapters and Harbor-Index: Infrastructure and a Curated Meta-Dataset for Large-Scale Agentic Evaluation",
    link: "https://arxiv.org/abs/2609.04298",
    suffix: ".",
    quoted: true,
  },
  {
    date: "2026-08",
    prefix: "Excited to join ",
    title: "Tencent",
    link: "https://www.tencent.com/en-us/",
    suffix:
      " as an intern with the Hunyuan AI Data Department, working on frontier benchmark research.",
    quoted: false,
  },
  {
    date: "2026-08",
    prefix: "Our paper ",
    title: "Unified Context Evolution for LLM Agents",
    link: "https://arxiv.org/abs/2606.02304",
    suffix: " was accepted to the EMNLP 2026 Main Conference.",
    quoted: true,
  },
  {
    date: "2026-07",
    prefix: "New blog post: ",
    title: "Introducing Harbor-Index",
    link: "https://harbor-index.org/",
    suffix: ", a compact benchmark for agentic evaluation.",
    quoted: true,
  },
]

const posts = [
  {
    title: "Introducing Harbor-Index",
    description:
      "A compact, diverse, challenging, and high-quality benchmark for agentic evaluation.",
    authors: ["Lin Shi", "Haowei Lin", "Zixuan Zhu", "Xiaoyue Zhou", "Xiang Li"],
    date: "2026-07",
    link: "https://harbor-index.org/",
    dataset:
      "https://hub.harborframework.com/datasets/harbor-index/harbor-index-1.0/latest",
  },
]
---

<Layout>
  <MetaPage slot="head" />

  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-intro">
      <p class="page-kicker" data-time-greeting>Hello! I'm</p>
      <h1 id="home-title"><em data-decode="Zixuan Zhu">Zixuan Zhu</em></h1>
      <p class="home-role">Currently an intern with the <a
          href="https://www.tencent.com/en-us/"
          target="_blank"
          rel="noopener noreferrer">Hunyuan AI Data Department at Tencent</a>, working on
          frontier benchmark research.</p>
    </div>
    <div class="home-hero-aside">
      <figure class="profile-photo">
        <img src="/static/profile.png" alt="Zixuan Zhu">
      </figure>
      <div class="social-links" aria-label="Social links">
        {SOCIALS.map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith("http") ? "_blank" : undefined}
            rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {social.label}
            {social.href.startsWith("http") && <span class="arrow"> ↗</span>}
          </a>
        ))}
      </div>
    </div>
    <div class="home-about">
        <p>
          I received my MSc in Financial Technology from the School of Physical and
          Mathematical Sciences at Nanyang Technological University (NTU) in 2026,
          after completing a dual bachelor's degree at Beijing University of Posts and
          Telecommunications (BUPT) and Queen Mary University of London (QMUL).
        </p>
        <p>
          I am also a core maintainer of <a
            href="https://www.harborframework.com/"
            target="_blank"
            rel="noopener noreferrer">Harbor</a
          >, working with the <a
            href="https://www.tbench.ai/"
            target="_blank"
            rel="noopener noreferrer">Terminal-Bench team</a
          > on scalable agent evaluation. I love open source and believe in its power
          to move research forward.
        </p>
        <p class="home-seeking">
          I am looking for PhD, RA, or research-internship opportunities, and I am open
          to research collaborations. Please feel free to reach out, even just for a
          coffee chat.
        </p>
        <p>My research currently centers on the following topics:</p>
        <ul class="interest-list">
          <li>
            <strong>Self-evolving agents</strong>: how agents can continually and stably
            self-improve from their own experience (<a
              href="https://arxiv.org/abs/2606.02304"
              target="_blank"
              rel="noopener noreferrer">UCE</a
            >).
          </li>
          <li>
            <strong>Scalable evaluation</strong>: how to scale agent evaluation
            efficiently and in parallel (<a
              href="https://www.harborframework.com/"
              target="_blank"
              rel="noopener noreferrer">Harbor</a
            >), and keep it robust and trustworthy.
          </li>
          <li>
            <strong>Economics of AI</strong>: how to reduce the token cost of agentic
            reasoning and get more capability from every token, until capable agents
            become viable on small, widely accessible models.
          </li>
        </ul>
        <p>
          I am fortunate to collaborate with <a
            href="https://people.csail.mit.edu/ludwigs/"
            target="_blank"
            rel="noopener noreferrer">Prof. Ludwig Schmidt</a
          >, <a
            href="https://slimshilin.github.io/"
            target="_blank"
            rel="noopener noreferrer">Lin Shi</a
          >, <a
            href="https://linhaowei1.github.io/"
            target="_blank"
            rel="noopener noreferrer">Haowei Lin</a
          >, <a
            href="https://crystalxyz.github.io/"
            target="_blank"
            rel="noopener noreferrer">Xiaoyue Zhou</a
          >, and <a
            href="https://kevinx.li/"
            target="_blank"
            rel="noopener noreferrer">Xiang Li</a
          > on agent benchmarking, and with <a
            href="https://dl-m9.github.io/"
            target="_blank"
            rel="noopener noreferrer">Senkang Hu</a
          > on self-evolving agents.
        </p>
    </div>
  </section>

  <section class="site-section" aria-labelledby="recent-news">
    <div class="section-label" id="recent-news">
      <span>Recent News</span>
    </div>
    <div class="news-list">
      {news.map((item) => (
        <div class="news-item">
          <time datetime={item.date}>{fmtMonth(item.date)}</time>
          <p>{item.prefix}{item.quoted && '"'}<a href={item.link} target="_blank" rel="noopener noreferrer">{item.title}</a>{item.quoted && '"'}{item.suffix}</p>
        </div>
      ))}
    </div>
  </section>

  <section
    class="site-section"
    id="publications"
    aria-labelledby="publications-label"
  >
    <div class="section-label" id="publications-label">
      <span>Publications</span>
    </div>
    <div class="ink-list">
      {publications.map((publication) => (
        <article class="ink-entry" id={publication.id}>
          <h2>{publication.data.title}</h2>
          <div class="entry-meta">
            <span class="tag">{publication.data.venue}</span>
            <span>{publication.data.date ? fmtMonth(publication.data.date) : publication.data.year}</span>
            {publication.data.status && <span>{publication.data.status}</span>}
            <span>
              {publication.data.authors.map((author, index) => (
                <Fragment>
                  {index > 0 && ", "}
                  {author === "Zixuan Zhu" ? <strong>{author}</strong> : author}
                </Fragment>
              ))}
            </span>
          </div>
          {publication.data.abstract && (
            <p class="entry-summary">{publication.data.abstract}</p>
          )}
          <div class="entry-links">
            {publication.data.arxiv && (
              <a href={publication.data.arxiv} target="_blank" rel="noopener noreferrer">
                Paper <span class="arrow">↗</span>
              </a>
            )}
            {publication.data.pdf && (
              <a href={publication.data.pdf} target="_blank" rel="noopener noreferrer">
                PDF <span class="arrow">↗</span>
              </a>
            )}
            {publication.data.code &&
              (publication.data.code.startsWith("http") ? (
                <a href={publication.data.code} target="_blank" rel="noopener noreferrer">
                  Code <span class="arrow">↗</span>
                </a>
              ) : (
                <span>Code ({publication.data.code})</span>
              ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" id="blog" aria-labelledby="blog-label">
    <div class="section-label" id="blog-label">
      <span>Blog</span>
    </div>
    <div class="ink-list">
      {posts.map((post) => (
        <article class="ink-entry">
          <h2>{post.title}</h2>
          <div class="entry-meta">
            <span>{fmtMonth(post.date)}</span>
            <span>
              {post.authors.map((author, index) => (
                <Fragment>
                  {index > 0 && ", "}
                  {author === "Zixuan Zhu" ? <strong>{author}</strong> : author}
                </Fragment>
              ))}
            </span>
          </div>
          <p class="entry-summary">{post.description}</p>
          <div class="entry-links">
            <a href={post.link} target="_blank" rel="noopener noreferrer">
              Blog <span class="arrow">↗</span>
            </a>
            {post.dataset && (
              <a href={post.dataset} target="_blank" rel="noopener noreferrer">
                Dataset <span class="arrow">↗</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" id="projects" aria-labelledby="projects-label">
    <div class="section-label" id="projects-label">
      <span>Projects</span>
    </div>
    <div class="ink-list">
      {projects.map((project) => (
        <article class="ink-entry" id={project.id}>
          <h2>{project.data.name}</h2>
          <div class="entry-meta">
            {project.data.role && <span class="tag">{project.data.role}</span>}
            {project.data.status && <span>{project.data.status}</span>}
            {project.data.tags?.map((tag) => <span>{tag}</span>)}
          </div>
          <p class="entry-summary">{project.data.description}</p>
          <div class="entry-links">
            {project.data.website && (
              <a href={project.data.website} target="_blank" rel="noopener noreferrer">
                Website <span class="arrow">↗</span>
              </a>
            )}
            {project.data.link && (
              <a href={project.data.link} target="_blank" rel="noopener noreferrer">
                Code <span class="arrow">↗</span>
              </a>
            )}
            {!project.data.website && !project.data.link && (
              <span class="project-status">Repository coming soon</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" aria-labelledby="github-heatmap">
    <div class="section-label" id="github-heatmap">
      <span>GitHub · Last Year</span>
    </div>
    <div class="heatmap-shell">
      <div
        class="heatmap"
        data-github-heatmap
        data-github-user={GITHUB_USERNAME}
        aria-label={`GitHub contribution heatmap for ${GITHUB_USERNAME}`}
      >
        <p class="heatmap-message">Loading GitHub contribution data...</p>
      </div>
    </div>
    <div class="heatmap-footer">
      <span class="heatmap-total" data-github-total></span>
      <span class="heatmap-legend" aria-hidden="true">
        less <i></i><i></i><i></i><i></i>
        more
      </span>
    </div>
  </section>

</Layout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "intro aside"
      "about aside";
    column-gap: var(--space-l);
    row-gap: var(--space-s);
    align-items: start;
    padding-block: var(--space-l) var(--space-m);
  }

  .home-hero-intro {
    grid-area: intro;
  }

  .home-hero-intro .page-kicker {
    text-transform: uppercase;
  }

  .home-about {
    grid-area: about;
  }

  .home-hero h1 {
    margin-block: 0 var(--space-s);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 3vw, 3.1rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.08;
  }

  .home-hero h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .home-role {
    margin-block: var(--space-2xs) 0;
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid var(--accent-soft);
    font-family: var(--font-mono);
    color: color-mix(in srgb, var(--foreground) 58%, transparent);
  }

  .news-item a {
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-color: currentColor;
  }

  .home-role a {
    color: var(--accent);
  }

  .home-about {
    max-inline-size: 58ch;
    margin-block: 0;
    color: var(--muted-foreground);
  }

  .home-about p {
    margin-block: 0 var(--space-s);
  }

  .home-about a {
    color: var(--accent);
    text-decoration: none;
  }

  .interest-list {
    margin-block: 0 var(--space-s);
    padding-inline-start: 1.1rem;
  }

  .interest-list li {
    margin-block-end: var(--space-2xs);
  }

  .interest-list strong {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  .home-seeking {
    color: var(--seek);
    font-weight: var(--font-weight-medium);
  }

  .home-hero-aside {
    grid-area: aside;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    align-items: flex-start;
  }

  .home-hero-aside .social-links {
    flex-direction: column;
    gap: 0.4rem;
  }

  .profile-photo {
    display: grid;
    gap: var(--space-2xs);
    justify-items: center;
    inline-size: 8.25rem;
    margin: 0;
    transform: rotate(0deg);
    transition: transform 0.25s ease;
  }

  .profile-photo:hover {
    transform: rotate(2deg);
  }

  .profile-photo img {
    inline-size: 8.25rem;
    block-size: 9.875rem;
    object-fit: cover;
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-sm);
    background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 8px,
        color-mix(in srgb, var(--accent) 8%, transparent) 8px,
        color-mix(in srgb, var(--accent) 8%, transparent) 16px
      ),
      var(--paper-soft);
  }

  .profile-photo figcaption {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (width < 40rem) {
    .home-hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        "intro"
        "aside"
        "about";
      gap: var(--space-m);
    }

    .home-hero-aside {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-m);
    }

    .home-hero-aside .social-links {
      flex: 1 1 10rem;
    }

    .profile-photo {
      transform: none;
    }
  }
</style>
